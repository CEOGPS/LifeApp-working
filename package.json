{
  "name": "lifeos1.agentzero",
  "private": true,
  "version": "0.1.0",
  "description": "LifeOS1 — AI-driven personal + business operating system",
  "author": "Chris Green <chris@ceogps.com>",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "// ── Web (Vite) ─────────────────────────────────────────": "",
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "build:check": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier-check": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "// ── Electron ───────────────────────────────────────────": "",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "pnpm build && electron-builder",
    "electron:build:win": "pnpm build && electron-builder --win",
    "electron:build:mac": "pnpm build && electron-builder --mac",
    "electron:build:linux": "pnpm build && electron-builder --linux",
    "electron:preview": "pnpm build && electron .",
    "// ── Deploy ─────────────────────────────────────────────": "",
    "deploy:pages": "pnpm build && wrangler pages deploy dist --project-name=lifeos1",
    "deploy:worker": "wrangler deploy --config worker/wrangler.worker.toml",
    "deploy": "pnpm deploy:pages && pnpm deploy:worker"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@mlc-ai/web-llm": "^0.2.85",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.101.1",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "agent-browser": "^0.27.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.41.0",
    "input-otp": "^1.4.2",
    "itty-router": "^5.0.24",
    "lucide-react": "^1.21.0",
    "motion": "^12.41.0",
    "next-themes": "^0.4.6",
    "octomailer": "^1.1.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.11.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1",
    "wrangler": "^4.35.0"
  },
  "build": {
    "appId": "com.ceogps.lifeos1",
    "productName": "LifeOS1",
    "copyright": "Copyright © 2026 Chris Green / CEO GPS",
    "directories": {
      "output": "electron-dist",
      "buildResources": "electron/build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "electron/build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/build/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "esbuild": true,
    "@swc/core": true,
    "workerd": true,
    "agent-browser": true,
    "sharp": true,
    "protobufjs": true,
    "electron": true,
    "electron-winstaller": true
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "protobufjs",
      "sharp",
      "workerd",
      "agent-browser",
      "electron",
      "electron-winstaller"
    ]
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  }
}