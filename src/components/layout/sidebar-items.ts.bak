export interface SidebarItem {
  id: string;
  label: string;
  icon: string;
  badge?: string | number;
  badgeVariant?: "default" | "primary" | "success" | "warning" | "danger";
  children?: SidebarItem[];
  href?: string;
  onClick?: () => void;
}

export interface SidebarSection {
  id: string;
  label: string;
  items: SidebarItem[];
  collapsible?: boolean;
  defaultOpen?: boolean;
}

